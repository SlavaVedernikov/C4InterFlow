{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C4InterFlow commands",
  "description": "The commands that can be executed with 'execute-commands'. This file is generated by the 'export-schema' command. Do not edit it.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/CommandEntry"
  },
  "minItems": 1,
  "$defs": {
    "CommandEntry": {
      "description": "A command to execute.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The name of the command to execute.",
          "enum": [
            "draw-diagrams",
            "query-use-flows",
            "execute-views",
            "generate-documentation"
          ]
        },
        "clearOutputDir": {
          "description": "If true, the contents of the directory specified by 'options.outputDir' are deleted before the command runs. Requires 'outputDir'. Defaults to false.",
          "type": "boolean",
          "default": false
        },
        "options": {
          "description": "Command-specific options. The allowed options depend on the value of 'command'.",
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "draw-diagrams"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/DrawDiagramsOptions"
              }
            },
            "required": [
              "options"
            ],
            "if": {
              "properties": {
                "clearOutputDir": {
                  "const": true
                }
              },
              "required": [
                "clearOutputDir"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "required": [
                    "outputDir"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "query-use-flows"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/QueryUseFlowsOptions"
              },
              "clearOutputDir": {
                "const": false,
                "description": "'clearOutputDir' is not supported by 'query-use-flows', as it has no '--output-dir' option."
              }
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "execute-views"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/ExecuteViewsOptions"
              }
            },
            "required": [
              "options"
            ],
            "if": {
              "properties": {
                "clearOutputDir": {
                  "const": true
                }
              },
              "required": [
                "clearOutputDir"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "required": [
                    "outputDir"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "generate-documentation"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/GenerateDocumentationOptions"
              }
            },
            "required": [
              "options"
            ],
            "if": {
              "properties": {
                "clearOutputDir": {
                  "const": true
                }
              },
              "required": [
                "clearOutputDir"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "required": [
                    "outputDir"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "DrawDiagramsOptions": {
      "description": "Options of the 'draw-diagrams' command. Draws diagrams",
      "type": "object",
      "properties": {
        "scopes": {
          "description": "Scopes of Diagram(s) to draw.",
          "type": "array",
          "items": {
            "enum": [
              "*",
              "all-software-systems",
              "business-process",
              "component",
              "component-interface",
              "container",
              "container-interface",
              "namespace",
              "namespace-software-systems",
              "software-system",
              "software-system-interface"
            ]
          },
          "default": [
            "*"
          ]
        },
        "types": {
          "description": "Types of Diagram(s) to draw.",
          "type": "array",
          "items": {
            "enum": [
              "*",
              "c4",
              "c4-sequence",
              "c4-static",
              "sequence"
            ]
          },
          "default": [
            "*"
          ]
        },
        "levelsOfDetails": {
          "description": "Levels of details of the Diagram(s).",
          "type": "array",
          "items": {
            "enum": [
              "*",
              "component",
              "container",
              "context"
            ]
          },
          "default": [
            "*"
          ]
        },
        "interfaces": {
          "description": "The aliases of the interfaces to be used as input for a Command",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfacesInputFile": {
          "description": "The file where the aliases of the Interfaces, which are intended to be used as input for a Command, can be loaded from.",
          "type": "string"
        },
        "businessProcesses": {
          "description": "The aliases of Business Processes for which to draw the Diagram(s).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaces": {
          "description": "The aliases of Namespaces for which to draw the Diagram(s).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formats": {
          "description": "Diagram format(s) to draw. NOTE: Diagram(s) in 'puml' format are always generated by default. 'svg', 'png' and 'md'arguments can be used for 'c4-static' and 'c4' diagram types only.",
          "type": "array",
          "items": {
            "enum": [
              "md",
              "png",
              "svg"
            ]
          }
        },
        "outputDir": {
          "description": "The output directory for the current command.",
          "type": "string"
        },
        "namePrefix": {
          "description": "The name prefix for a Diagram.",
          "type": "string"
        },
        "aacInputPaths": {
          "description": "The paths to the Architecture As Code input.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "maxLineLabels": {
          "description": "The numner of new-line delimited labels per a line on a Diagram.",
          "type": "integer",
          "default": 10
        },
        "expandUpstream": {
          "description": "Expand the diagram upstream from the scoped structure. NOTE: This option is used for 'c4' and 'c4-static' diagram types only.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "aacInputPaths"
      ],
      "additionalProperties": false
    },
    "QueryUseFlowsOptions": {
      "description": "Options of the 'query-use-flows' command. Finds all interface(s) that Use given interface(s) in their Flows.",
      "type": "object",
      "properties": {
        "interfaces": {
          "description": "The aliases of the interfaces to be used as input for a Command",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recursive": {
          "description": "Indicates if the Query should be executed recursively. Default false.",
          "type": "boolean",
          "default": false
        },
        "queryOutputFile": {
          "description": "The name of the file where the Query results should be saved.",
          "type": "string"
        },
        "append": {
          "description": "Append Query results to an output file. Default false.",
          "type": "boolean",
          "default": false
        },
        "aacInputPaths": {
          "description": "The paths to the Architecture As Code input.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "aacInputPaths"
      ],
      "additionalProperties": false
    },
    "ExecuteViewsOptions": {
      "description": "Options of the 'execute-views' command. Executes Architecture As Code generation Strategy",
      "type": "object",
      "properties": {
        "views": {
          "description": "The aliases of the views to be used as input for a Command",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "outputDir": {
          "description": "The output directory for the current command.",
          "type": "string"
        },
        "namePrefix": {
          "description": "The name prefix for a Diagram.",
          "type": "string"
        },
        "aacInputPaths": {
          "description": "The paths to the Architecture As Code input.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "viewInputPaths": {
          "description": "The paths to the Architecture Views input.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "views",
        "aacInputPaths",
        "viewInputPaths"
      ],
      "additionalProperties": false
    },
    "GenerateDocumentationOptions": {
      "description": "Options of the 'generate-documentation' command. Generate Documentation",
      "type": "object",
      "properties": {
        "structures": {
          "description": "The aliases of the structures to be used as input for a Command",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templatesDir": {
          "description": "The directory where documentation templates for structures can be found",
          "type": "string"
        },
        "outputDir": {
          "description": "The output directory for the current command.",
          "type": "string"
        },
        "fileExtension": {
          "description": "The file extension of the artifact used/generated by the command",
          "type": "string"
        },
        "aacInputPaths": {
          "description": "The paths to the Architecture As Code input.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "aacInputPaths"
      ],
      "additionalProperties": false
    }
  }
}
